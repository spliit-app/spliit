# Port mapping on the host (change this if 3000 is already in use, e.g. PORT=3001)
PORT=3000

# Database configuration (SQLite file path inside container)
DATABASE_URL=file:/data/spliit.db

# Authentication (JWT session secret)
AUTH_SECRET=development_secret_key_minimum_32_characters_long

# Session duration in days before requiring re-login (defaults to 365 days / 1 year)
# AUTH_SESSION_MAX_AGE_DAYS=365

# OAuth Providers (configure for production logins)
# Google OAuth:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# GitHub OAuth:
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR
